# ============================================================
# Arkik Productions — Variables de entorno (plantilla)
# Copia a .env.local para desarrollo. NUNCA committees .env, .env.local ni .dev.vars.
# En Vercel: Project Settings > Environment Variables.
# ============================================================

# --- Base de datos (Neon PostgreSQL) ---
# Runtime Vercel y servidor local (endpoint Pooled "-pooler", rol mínimo arkik_app).
# Solo server-side. Nunca la expongas al navegador.
DATABASE_URL=

# Solo uso local / CLI de migraciones y seed local (endpoint Direct de Neon SIN "-pooler").
# Utilizado exclusivamente por db/migrate.js (npm run db:migrate) y db/seed-dev.js.
# NUNCA agregues DIRECT_DATABASE_URL a las variables de entorno del runtime en Vercel.
DIRECT_DATABASE_URL=

# Solo uso local / CLI administrativo de PINs (endpoint Direct de Neon SIN "-pooler", rol mínimo arkik_admin).
# Utilizado exclusivamente por db/manage-admin-pins.js (npm run admin:verify / npm run admin:rotate).
# Sin fallback hacia DIRECT_DATABASE_URL ni DATABASE_URL. NUNCA agregues esta variable a Vercel.
DIRECT_ADMIN_DATABASE_URL=

# --- Entorno ---
# Valores reconocidos: development | staging | preview | production
# El fallback stateless local (sin DATABASE_URL) SOLO se habilita con APP_ENV=development
# explícito y sin flags cloud/producción (VERCEL, VERCEL_ENV, NODE_ENV=production).
APP_ENV=development

# --- Semillas de desarrollo ---
# true  -> db:seed:dev puede insertar datos demo (SOLO APP_ENV=development + host loopback local)
# false -> valor seguro por defecto: bookings/availability/audit arrancan VACÍOS
SEED_MODE=false

# --- Autenticación administrativa ---
# PIN de cada rol (mínimo 6 y máximo 64 caracteres, o hash scrypt$), SOLO aquí (nunca en código ni cliente).
# El migrador (npm run db:migrate) calcula el hash scrypt y lo guarda en admin_credentials.
ADMIN_OWNER_PIN=
ADMIN_IT_PIN=

# Secreto para firmar tokens de sesión (genera uno aleatorio de 64+ chars).
# Obligatorio en staging, preview, production, cloud o con DATABASE_URL (503 si falta).
# Generar con Node.js:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O con OpenSSL:
#   openssl rand -hex 48
ADMIN_SESSION_SECRET=

# --- API / CORS ---
# Orígenes permitidos para CORS (separados por coma).
# Vacío = same-origin únicamente (recomendado cuando frontend y API viven en Vercel).
ALLOWED_ORIGINS=

# --- Cookies / TLS fuera de Vercel ---
# Activa el atributo Secure en cookies de sesión cuando la app se despliega fuera de
# Vercel con terminación TLS (staging/preview en contenedor o PaaS). Por defecto false
# para permitir smoke tests locales sobre http://localhost. En Vercel siempre es Secure.
# SECURE_COOKIES=false
