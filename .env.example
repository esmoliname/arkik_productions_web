# ============================================================
# Arkik Productions — Variables de entorno (plantilla)
# Copia a .env.local para desarrollo. NUNCA committees .env real.
# En Vercel: Project Settings > Environment Variables.
# ============================================================

# --- Base de datos (Neon) ---
# Cadena de conexión PostgreSQL de Neon. Solo server-side (Vercel).
# Nunca la expongas al navegador.
DATABASE_URL=

# --- Entorno ---
# development | preview | production
APP_ENV=development

# --- Semillas de desarrollo ---
# true  -> db:seed:dev puede insertar datos demo (SOLO desarrollo local)
# false -> producción: bookings/availability/audit arrancan VACÍOS
SEED_MODE=true

# --- Autenticación administrativa ---
# PIN de cada rol, en claro SOLO aquí (nunca en código ni en el cliente).
# El migrador calcula el hash scrypt y lo guarda en admin_credentials.
ADMIN_OWNER_PIN=
ADMIN_IT_PIN=

# Secreto para firmar tokens de sesión (genera uno aleatorio de 64+ chars).
# Ejemplo: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- API ---
# Orígenes permitidos para CORS (separados por coma).
# Vacío = same-origin únicamente (recomendado: frontend y API en Vercel).
ALLOWED_ORIGINS=

# URL pública de la app (para links/emails). Ej: https://arkik.example.com
PUBLIC_APP_URL=
