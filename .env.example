# ============================================================
# Arkik Productions — Variables de entorno (plantilla)
# Copia a .env.local para desarrollo. NUNCA committees .env real.
# En Vercel: Project Settings > Environment Variables.
# ============================================================

# --- Base de datos (Neon) ---
# Cadena de conexión PostgreSQL de Neon. Solo server-side (Vercel).
# Nunca la expongas al navegador.
DATABASE_URL=

# --- Entorno ---
# Valores reconocidos: development | staging | preview | production
# El fallback stateless local (sin DATABASE_URL) SOLO se habilita con APP_ENV=development
# explícito y sin flags cloud/producción (VERCEL, VERCEL_ENV, NODE_ENV=production).
APP_ENV=development

# --- Semillas de desarrollo ---
# true  -> db:seed:dev puede insertar datos demo (SOLO desarrollo local explícito)
# false -> valor seguro por defecto: bookings/availability/audit arrancan VACÍOS
SEED_MODE=false

# --- Autenticación administrativa ---
# PIN de cada rol, en claro SOLO aquí (nunca en código ni en el cliente).
# El migrador calcula el hash scrypt y lo guarda en admin_credentials.
ADMIN_OWNER_PIN=
ADMIN_IT_PIN=

# Secreto para firmar tokens de sesión (genera uno aleatorio de 64+ chars).
# Obligatorio en staging, preview, production, cloud o con DATABASE_URL (503 si falta).
# Ejemplo: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- API ---
# Orígenes permitidos para CORS (separados por coma).
# Vacío = same-origin únicamente (recomendado: frontend y API en Vercel).
ALLOWED_ORIGINS=

# URL pública de referencia de la app (opcional, metadato operativo; no requerida por api/). Ej: https://arkik.example.com
PUBLIC_APP_URL=
